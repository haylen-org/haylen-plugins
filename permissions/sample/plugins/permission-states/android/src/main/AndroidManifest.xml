<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The permission "asked", which Android asks the person for from Android 13 on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- The provider of the `haylen-plugins` library creates and loads the plugin class that this entry names when the app process starts. -->
        <meta-data
            android:name="dev.haylen.plugin.permission-states"
            android:value="com.haylen.plugins.permissionstates.PermissionStatesPlugin" />
    </application>
</manifest>
