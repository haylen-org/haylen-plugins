{
    "name": "Pack Lab",
    "identifier": "com.haylen.packlab",
    "version": "1.0.0",
    "category": "developer",
    "description": "Checks the delivery of the named packs of the content by Google Play and by the App Store.",
    "orientation": "landscape",
    "window": {
        "title": "Pack Lab",
        "width": 1280,
        "height": 720,
        "resizable": true
    },
    "design": {
        "width": 1920,
        "height": 1080,
        "scaling": "expand"
    },
    "clearColor": "#FF101418",
    "splash": {
        "logo": "logo.png",
        "background": "#FF101418"
    },
    "plugins": {
        "play-asset-delivery": {
            "path": "../play-asset-delivery",
            "parameters": {
                "fastFollowPacks": [
                    "intro.music"
                ]
            }
        },
        "background-assets": {
            "path": "../background-assets",
            "parameters": {
                "prefetchPacks": [
                    "intro.music"
                ]
            }
        }
    },
    "content": {
        "delivery": [
            {
                "match": "chapters/two/**",
                "pack": "chapter-2"
            },
            {
                "match": "music/**",
                "pack": "intro.music"
            }
        ]
    }
}
