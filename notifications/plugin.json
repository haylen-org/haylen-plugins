{
    "interface": 1,
    "id": "notifications",
    "name": "Notifications",
    "version": "1.0.0",
    "description": "Local notifications that the app schedules, cancels and lists, and the tap that opens the app.",
    "implementations": {"ios": "native", "catalyst": "native", "tvos": "lua", "visionos": "native", "macos": "native", "android": "native", "web": "native", "windows": "native", "linux": "native"},
    "dependencies": {"permissions": "1.0.0"},
    "permissions": ["notifications"],
    "parameters": {
        "channelName": {
            "type": "string",
            "platforms": ["android"],
            "default": "Notifications",
            "description": "Name of the notification channel with sound, which the person sees in the settings of the app."
        },
        "silentChannelName": {
            "type": "string",
            "platforms": ["android"],
            "default": "Silent notifications",
            "description": "Name of the notification channel without sound, which the notifications with \"sound = false\" use."
        }
    },
    "contributions": [
        {"type": "appleClass", "platforms": ["ios", "catalyst", "visionos", "macos"], "name": "NotificationsPlugin"},
        {"type": "appleSources", "platforms": ["ios", "catalyst", "visionos", "macos"], "path": "apple"},
        {"type": "framework", "platforms": ["ios", "catalyst", "visionos", "macos"], "name": "UserNotifications.framework"},
        {"type": "gradleModule", "platforms": ["android"], "path": "android"},
        {"type": "webModule", "platforms": ["web"], "path": "web/notifications.js"},
        {"type": "nativeLibrary", "platforms": ["windows", "linux"], "cmake": "native"}
    ]
}
