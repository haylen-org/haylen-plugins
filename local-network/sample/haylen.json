{
    "name": "Local Network",
    "identifier": "com.haylen.localnetwork",
    "version": "1.0.0",
    "category": "developer",
    "description": "The sample of the Local Network plugin, which advertises a service of its own, picks it and connects to it.",
    "orientation": "any",
    "window": {
        "title": "Local Network",
        "width": 1280,
        "height": 720,
        "resizable": true
    },
    "design": {
        "width": 1920,
        "height": 1080,
        "scaling": "expand"
    },
    "clearColor": "#FF101418",
    "splash": {
        "logo": "logo.png",
        "background": "#FF101418"
    },
    "plugins": {
        "permissions": {"path": "../../permissions"},
        "local-network": {
            "path": "..",
            "parameters": {
                "localNetworkUsage": "The sample finds and connects to its own service on the local network.",
                "bonjourServices": ["_haylen-sample._tcp"]
            }
        }
    }
}
