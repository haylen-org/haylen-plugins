<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- The provider of the `haylen-plugins` library creates and loads the plugin class that this entry names when the app process starts. -->
        <meta-data
            android:name="dev.haylen.plugin.firebase-crashlytics"
            android:value="com.haylen.plugins.firebasecrashlytics.FirebaseCrashlyticsPlugin" />
        <!-- Whether Crashlytics sends reports from the start, from the parameter `collectionEnabled`. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="${firebaseCrashlyticsCollectionEnabled}" />
    </application>
</manifest>
