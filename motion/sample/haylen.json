{
    "name": "Motion Sample",
    "identifier": "com.haylen.motion",
    "version": "1.0.0",
    "category": "utility",
    "description": "Starts the motion sensors of the Motion plugin, shows every reading and the tilt, and rolls a ball with it.",
    "orientation": "any",
    "window": {
        "title": "Motion Sample",
        "width": 1280,
        "height": 720,
        "resizable": true
    },
    "design": {
        "width": 1920,
        "height": 1080,
        "scaling": "expand"
    },
    "clearColor": "#FF101418",
    "splash": {
        "logo": "logo.png",
        "background": "#FF101418"
    },
    "plugins": {
        "permissions": {"path": "../../permissions"},
        "motion": {"path": "..", "parameters": {"motionUsage": "The sample shows how the device moves and leans."}}
    }
}
